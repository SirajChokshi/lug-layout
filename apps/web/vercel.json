{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "ignoreCommand": "[ \"$VERCEL_GIT_PREVIOUS_SHA\" = \"$VERCEL_GIT_COMMIT_SHA\" ] && exit 1; exit 0",
  "installCommand": "pnpm install --frozen-lockfile --filter @brr/web... --filter @brr/asset-pipeline...",
  "buildCommand": "sh vercel-build.sh",
  "outputDirectory": "dist"
}
