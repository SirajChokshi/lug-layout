{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "brr-catalog-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "send_metrics": false,
  "d1_databases": [
    {
      "binding": "CATALOG_DB",
      "database_name": "brr-catalog"
    }
  ],
  "r2_buckets": [
    {
      "binding": "CATALOG_RELEASES",
      "bucket_name": "brr-catalog-releases"
    }
  ],
  "ratelimits": [
    {
      "name": "QUERY_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": {
        "limit": 100,
        "period": 60
      }
    }
  ]
}
