+pub fn sight_lines(instances: &[CoverInstance], solids: &[PartSolid], opacity: &Opacity, target: Vec3, eye: Vec3, stud: StudShape) -> Vec<(f64, f64, f64)> {
+    let boxes: Vec<[Vec3; 2]> = instances.iter().map(|i| world_box(i, &solids[i.part])).collect();
+    let model = ModelSolids::new(instances, &boxes, solids, opacity);
+    let mut out = Vec::new();
+    for (o, inst) in instances.iter().enumerate() {
+        for st in inst.studs {
+            let f = StudFrame::of(&inst.matrix.then(st));
+            if (0..3).any(|a| (f.base[a] - target[a]).abs() > 0.1) { continue; }
+            let _ = o;
+            for hk in 1..10 {
+                let h = stud.height * hk as f64 / 10.0;
+                for k in 0..64 {
+                    let a = std::f64::consts::TAU * k as f64 / 64.0;
+                    let r = [a.cos(), 0.0, a.sin()];
+                    let p = [0, 1, 2].map(|i| f.base[i] + f.up[i] * h + r[i] * stud.radius * 1.001);
+                    let d = sub(eye, p);
+                    let len = dot(d, d).sqrt();
+                    let dir = d.map(|v| v / len);
+                    if dot(dir, r) <= 0.0 { continue; }
+                    let mut seen = Vec::new();
+                    if !model.blocked_within(p, dir, len, &mut seen) {
+                        let mut first = 0.0;
+                        for reach in [5.0, 10.0, 20.0, 40.0, 60.0, 100.0, 200.0, 400.0] {
+                            if model.blocked_within(p, dir, reach, &mut seen) { first = reach; break; }
+                        }
+                        out.push((h, a.to_degrees(), first));
+                    }
+                }
+            }
+        }
+    }
+    out
+}
