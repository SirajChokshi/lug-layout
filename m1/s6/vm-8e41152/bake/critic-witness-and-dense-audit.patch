+pub struct Witness {
+    pub stud: usize,
+    pub owner: usize,
+    pub from: Vec3,
+    pub direction: Vec3,
+}
+
+pub fn below_witnesses(
+    instances: &[CoverInstance],
+    solids: &[PartSolid],
+    visible: &[bool],
+    stud: StudShape,
+    free_ldu: f64,
+) -> Vec<Witness> {
+    let boxes: Vec<[Vec3; 2]> = instances.iter().map(|i| world_box(i, &solids[i.part])).collect();
+    let inverses: Vec<Option<Affine>> = instances.iter().map(|i| inverse(i.matrix)).collect();
+    let cell = 40.0;
+    let key = |v: f64| (v / cell).floor() as i64;
+    let mut grid: HashMap<BroadKey, Vec<usize>> = HashMap::new();
+    for (i, [min, max]) in boxes.iter().enumerate() {
+        for x in key(min[0])..=key(max[0]) {
+            for y in key(min[1])..=key(max[1]) {
+                for z in key(min[2])..=key(max[2]) {
+                    grid.entry((x, y, z)).or_default().push(i);
+                }
+            }
+        }
+    }
+    let blocked = |origin: Vec3, direction: Vec3| -> bool {
+        let end = [0, 1, 2].map(|a| origin[a] + direction[a] * free_ldu);
+        let lo = [0, 1, 2].map(|a| key(origin[a].min(end[a])));
+        let hi = [0, 1, 2].map(|a| key(origin[a].max(end[a])));
+        let mut seen = std::collections::HashSet::new();
+        for x in lo[0]..=hi[0] {
+            for y in lo[1]..=hi[1] {
+                for z in lo[2]..=hi[2] {
+                    for &i in grid.get(&(x, y, z)).map(|v| v.as_slice()).unwrap_or(&[]) {
+                        if !seen.insert(i) {
+                            continue;
+                        }
+                        let Some(inv) = &inverses[i] else { continue };
+                        let lo_o = inv.apply(origin);
+                        let lo_e = inv.apply(end);
+                        let ld = [0, 1, 2].map(|a| (lo_e[a] - lo_o[a]) / free_ldu);
+                        if solids[instances[i].part]
+                            .triangles
+                            .iter()
+                            .any(|t| first_hit_t(lo_o, ld, t).is_some_and(|tt| tt <= free_ldu))
+                        {
+                            return true;
+                        }
+                    }
+                }
+            }
+        }
+        false
+    };
+    let mut out = Vec::new();
+    let mut s = 0;
+    for (owner, instance) in instances.iter().enumerate() {
+        for st in instance.studs {
+            let index = s;
+            s += 1;
+            if visible[index] {
+                continue;
+            }
+            let frame = StudFrame::of(&instance.matrix.then(st));
+            if dot(frame.up, UP) < UPRIGHT_COSINE {
+                continue;
+            }
+            'search: for az in 0..16 {
+                let a = std::f64::consts::TAU * az as f64 / 16.0;
+                let radial = [a.cos(), 0.0, a.sin()];
+                for frac in [0.5, 0.95] {
+                    let from = [0, 1, 2].map(|k| frame.base[k] + UP[k] * stud.height * frac + radial[k] * stud.radius * 1.001);
+                    for elev in [-10.0f64, -20.0, -30.0, -45.0, -60.0] {
+                        let (sn, cs) = elev.to_radians().sin_cos();
+                        let direction = [radial[0] * cs, sn, radial[2] * cs];
+                        if !blocked(from, direction) {
+                            out.push(Witness { stud: index, owner, from, direction });
+                            break 'search;
+                        }
+                    }
+                }
+            }
+        }
+    }
+    out
+}
