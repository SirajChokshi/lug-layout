+pub fn dense_audit(instances: &[CoverInstance], solids: &[PartSolid], opacity: &Opacity, visible: &[bool], stud: StudShape) -> usize {
+    let boxes: Vec<[Vec3; 2]> = instances.iter().map(|i| world_box(i, &solids[i.part])).collect();
+    let model = ModelSolids::new(instances, &boxes, solids, opacity);
+    let mut frames = Vec::new();
+    let mut culled_seen = 0usize;
+    let mut s = 0;
+    for inst in instances {
+        for st in inst.studs {
+            if !visible[s] { culled_seen += 1; if culled_seen % 10 == 0 { frames.push(StudFrame::of(&inst.matrix.then(st))); } }
+            s += 1;
+        }
+    }
+    let workers = std::thread::available_parallelism().map_or(1, |n| n.get());
+    let chunk = frames.len().div_ceil(workers).max(1);
+    let mut found = vec![0usize; frames.len().div_ceil(chunk)];
+    std::thread::scope(|scope| {
+        for (slice, out) in frames.chunks(chunk).zip(found.iter_mut()) {
+            let model = &model;
+            scope.spawn(move || {
+                let mut seen = Vec::new();
+                for f in slice {
+                    let mut open = false;
+                    'stud: for hk in 1..=16 {
+                        let h = stud.height * (hk as f64 - 0.5) / 16.0;
+                        for k in 0..128 {
+                            let a = std::f64::consts::TAU * (k as f64 + 0.5) / 128.0;
+                            let r = [0, 1, 2].map(|i| f.across[i] * a.cos() + f.along[i] * a.sin());
+                            let p = [0, 1, 2].map(|i| f.base[i] + f.up[i] * h + r[i] * stud.radius * 1.001);
+                            for e in 1..72 {
+                                let (rise, run) = (-1.25 * e as f64).to_radians().sin_cos();
+                                let d = [0, 1, 2].map(|i| r[i] * run + f.up[i] * rise);
+                                if !model.blocked_within(p, d, 60.0, &mut seen) { open = true; break 'stud; }
+                            }
+                        }
+                    }
+                    if open { *out += 1; }
+                }
+            });
+        }
+    });
+    let open: usize = found.iter().sum();
+    eprintln!("AUDITSAMPLE sampled={} open={open}", frames.len());
+    open
+}
