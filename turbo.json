{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "@brr/asset-pipeline#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "!src/**/*.test.ts",
        "!src/library/**",
        "!src/library-bake/**",
        "!src/pointer/**",
        "!src/publication/**",
        "!src/library-connectors/**",
        "!src/input-key-cli.ts",
        "!src/shadow-library/**",
        "palette.json",
        "fixture-models.json",
        "omr-errata.json",
        "primitive-connectors.json",
        "inferred-connectors.json",
        "section-vocabulary.json",
        "shadow-patches/**",
        "ldraw.lock.json",
        "library-bake.json",
        "library-connectors.json",
        "shadow-library.json",
        "third-party-track.json",
        "$TURBO_ROOT$/crates/**",
        "$TURBO_ROOT$/Cargo.toml",
        "$TURBO_ROOT$/Cargo.lock",
        "$TURBO_ROOT$/rust-toolchain.toml",
        "$TURBO_ROOT$/docs/verified-facts/scenes/**",
        "$TURBO_ROOT$/docs/verified-facts/geometry.json",
        "$TURBO_ROOT$/docs/verified-facts/track-catalog.json",
        "$TURBO_ROOT$/docs/verified-facts/level-crossing.json",
        "$TURBO_ROOT$/packages/schema/src/bundle/**",
        "!$TURBO_ROOT$/packages/schema/src/bundle/**/*.test.ts",
        "$TURBO_ROOT$/packages/schema/src/decode/**",
        "!$TURBO_ROOT$/packages/schema/src/decode/**/*.test.ts",
        "$TURBO_ROOT$/packages/math/src/**",
        "!$TURBO_ROOT$/packages/math/src/**/*.test.ts",
        "$TURBO_ROOT$/packages/catalog/src/connector-license.ts",
        "$TURBO_ROOT$/packages/catalog/src/glb.ts",
        "$TURBO_ROOT$/packages/catalog/src/part-bundle.ts",
        "$TURBO_ROOT$/packages/domain/src/plan/degenerate-outline.ts",
        "$TURBO_ROOT$/packages/domain/src/track/heading-footprints.ts",
        "$TURBO_ROOT$/packages/domain/src/track/piece-outline.ts"
      ],
      "outputs": ["dist/**", "fixture-bundle/**"],
      "passThroughEnv": ["RUSTUP_HOME", "CARGO_HOME", "RUSTUP_TOOLCHAIN"]
    },
    "@brr/domain#test": {
      "dependsOn": ["^build", "@brr/asset-pipeline#build"]
    },
    "@brr/client#test": {
      "dependsOn": ["^build", "@brr/asset-pipeline#build"]
    },
    "@brr/web#build": {
      "dependsOn": ["^build", "@brr/asset-pipeline#build"],
      "outputs": ["dist/**"]
    },
    "@brr/import#test": {
      "dependsOn": ["^build", "@brr/asset-pipeline#build"]
    },
    "@brr/import-worker#test": {
      "dependsOn": ["^build", "@brr/asset-pipeline#build"]
    },
    "@brr/e2e#e2e": {
      "dependsOn": ["@brr/web#build"],
      "cache": false,
      "passThroughEnv": ["CI", "CHROME", "HELD_OUT_SEED", "LIBRARY_BAKE_REQUEST_LOG"]
    },
    "@brr/e2e#e2e:library-bake": {
      "dependsOn": ["@brr/web#build"],
      "cache": false,
      "passThroughEnv": ["CI", "CHROME"]
    }
  }
}
