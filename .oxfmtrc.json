{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "ignorePatterns": [
    "**/dist/**",
    "pnpm-lock.yaml",
    "packages/compile-wasm/**",
    "docs/**",
    ".cursor/**",
    "AGENTS.md",
    "README.md",
    "packages/test-fixtures/**",
    "tools/asset-pipeline/ldraw.lock.json",
    "tools/asset-pipeline/omr-library.json",
    "tools/asset-pipeline/shadow-patches/**",
    "target/**"
  ]
}
