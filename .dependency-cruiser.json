{
  "forbidden": [
    {
      "name": "no-unresolvable-import",
      "severity": "error",
      "from": {},
      "to": {
        "couldNotResolve": true
      }
    },
    {
      "name": "nothing-imports-tools",
      "severity": "error",
      "from": {
        "pathNot": "^tools/"
      },
      "to": {
        "path": "^tools/"
      }
    },
    {
      "name": "inversify-only-in-di-packages",
      "severity": "error",
      "from": {
        "pathNot": "^(packages/(client|workers|storage|render|catalog|rpc)|apps/web|tools/e2e)/"
      },
      "to": {
        "path": "(^|/)node_modules/inversify/"
      }
    },
    {
      "name": "three-only-in-render",
      "severity": "error",
      "from": {
        "pathNot": "^packages/render/"
      },
      "to": {
        "path": "(^|/)node_modules/three/"
      }
    },
    {
      "name": "math-depends-on-nothing",
      "severity": "error",
      "from": {
        "path": "^packages/math/"
      },
      "to": {
        "pathNot": "^packages/math/"
      }
    },
    {
      "name": "schema-depends-on-math",
      "severity": "error",
      "from": {
        "path": "^packages/schema/"
      },
      "to": {
        "pathNot": ["^packages/(math|schema)/", "(^|/)node_modules/valibot/"]
      }
    },
    {
      "name": "domain-depends-on-math-and-schema",
      "severity": "error",
      "from": {
        "path": "^packages/domain/"
      },
      "to": {
        "pathNot": "^packages/(math|schema|domain)/"
      }
    },
    {
      "name": "sim-depends-on-math-schema-domain",
      "severity": "error",
      "from": {
        "path": "^packages/sim/"
      },
      "to": {
        "pathNot": "^packages/(math|schema|domain|sim)/"
      }
    },
    {
      "name": "catalog-depends-on-math-schema-valibot-inversify",
      "severity": "error",
      "from": {
        "path": "^packages/catalog/"
      },
      "to": {
        "pathNot": ["^packages/(math|schema|catalog)/", "(^|/)node_modules/(inversify|valibot)/"]
      }
    },
    {
      "name": "render-never-imports-domain",
      "severity": "error",
      "from": {
        "path": "^packages/render/"
      },
      "to": {
        "pathNot": [
          "^packages/(math|schema|catalog|render)/",
          "(^|/)node_modules/(inversify|three)/"
        ]
      }
    },
    {
      "name": "storage-and-rpc-depend-on-schema-inversify",
      "severity": "error",
      "from": {
        "path": "^packages/(storage|rpc)/"
      },
      "to": {
        "pathNot": ["^packages/(schema|storage|rpc)/", "(^|/)node_modules/inversify/"]
      }
    },
    {
      "name": "import-depends-on-its-engines",
      "severity": "error",
      "from": {
        "path": "^packages/import/"
      },
      "to": {
        "pathNot": "^packages/(math|schema|domain|catalog|compile-wasm|import)/"
      }
    },
    {
      "name": "client-depends-on-math-l2-and-sim-import-types",
      "severity": "error",
      "from": {
        "path": "^packages/client/"
      },
      "to": {
        "pathNot": [
          "^packages/(math|schema|domain|catalog|render|storage|rpc|sim|import|client)/",
          "(^|/)node_modules/inversify/"
        ]
      }
    },
    {
      "name": "client-takes-only-types-from-sim-and-import",
      "severity": "error",
      "from": {
        "path": "^packages/client/"
      },
      "to": {
        "path": "^packages/(sim|import)/",
        "dependencyTypesNot": ["type-only"]
      }
    },
    {
      "name": "placement-hover-takes-only-types",
      "severity": "error",
      "from": {
        "path": "^packages/client/src/edit/placement-hover\\.ts$"
      },
      "to": {
        "dependencyTypesNot": ["type-only"]
      }
    },
    {
      "name": "track-world-never-imports-the-edit-tools",
      "severity": "error",
      "from": {
        "path": "^packages/client/src/edit/track-world\\.ts$"
      },
      "to": {
        "path": "^packages/client/src/edit/(track-edit-session|road-edit-session|editor)\\.ts$"
      }
    },
    {
      "name": "workers-depend-on-rpc-and-their-engine",
      "severity": "error",
      "from": {
        "path": "^packages/workers/",
        "pathNot": "^packages/workers/import-worker/"
      },
      "to": {
        "pathNot": [
          "^packages/(rpc|sim|import|render|math|schema|domain|catalog|compile-wasm|workers)/",
          "(^|/)node_modules/inversify/"
        ]
      }
    },
    {
      "name": "import-worker-depends-on-rpc-import-and-storage",
      "severity": "error",
      "from": {
        "path": "^packages/workers/import-worker/"
      },
      "to": {
        "pathNot": [
          "^packages/(rpc|import|math|schema|domain|catalog|compile-wasm|storage|workers)/",
          "(^|/)node_modules/inversify/"
        ]
      }
    },
    {
      "name": "ui-goes-through-client",
      "severity": "error",
      "from": {
        "path": "^packages/ui/"
      },
      "to": {
        "pathNot": ["^packages/(client|schema|ui)/", "(^|/)node_modules/(react|react-dom)/"]
      }
    },
    {
      "name": "ui-takes-only-types-from-schema",
      "severity": "error",
      "from": {
        "path": "^packages/ui/"
      },
      "to": {
        "path": "^packages/schema/",
        "dependencyTypesNot": ["type-only"]
      }
    },
    {
      "name": "web-composes-ui-client-workers-and-schema-types",
      "severity": "error",
      "from": {
        "path": "^apps/web/"
      },
      "to": {
        "pathNot": [
          "^apps/web/",
          "^packages/(ui|client|workers|schema)/",
          "(^|/)node_modules/(inversify|react|react-dom)/"
        ]
      }
    },
    {
      "name": "web-takes-only-types-from-schema",
      "severity": "error",
      "from": {
        "path": "^apps/web/"
      },
      "to": {
        "path": "^packages/schema/",
        "dependencyTypesNot": ["type-only"]
      }
    },
    {
      "name": "asset-pipeline-depends-on-pure-packages-and-catalog",
      "severity": "error",
      "from": {
        "path": "^tools/asset-pipeline/"
      },
      "to": {
        "path": "^packages/",
        "pathNot": "^packages/(math|schema|domain|catalog)/"
      }
    },
    {
      "name": "asset-pipeline-imports-only-valibot-from-npm",
      "severity": "error",
      "from": {
        "path": "^tools/asset-pipeline/"
      },
      "to": {
        "path": "(^|/)node_modules/",
        "pathNot": "(^|/)node_modules/valibot/"
      }
    },
    {
      "name": "e2e-composes-only-its-approved-packages",
      "severity": "error",
      "from": {
        "path": "^tools/e2e/"
      },
      "to": {
        "path": "^(packages|apps|tools/asset-pipeline)/",
        "pathNot": "^packages/(math|schema|catalog|import|client|render|storage)/"
      }
    },
    {
      "name": "e2e-imports-only-its-tooling-from-npm",
      "severity": "error",
      "from": {
        "path": "^tools/e2e/"
      },
      "to": {
        "path": "(^|/)node_modules/",
        "pathNot": "(^|/)node_modules/(valibot|inversify|vitest|playwright-core|@playwright/test)/"
      }
    },
    {
      "name": "catalog-api-imports-only-schema",
      "severity": "error",
      "from": {
        "path": "^apps/catalog-api/"
      },
      "to": {
        "path": "^(packages|tools|apps/web)/",
        "pathNot": "^packages/schema/"
      }
    },
    {
      "name": "nothing-imports-catalog-api",
      "severity": "error",
      "from": {
        "pathNot": "^apps/catalog-api/"
      },
      "to": {
        "path": "^apps/catalog-api/"
      }
    }
  ],
  "options": {
    "doNotFollow": {
      "path": "(^|/)node_modules/"
    },
    "exclude": {
      "path": "(\\.(test|test-support|bench)\\.ts$|(^|/)vitest\\.config\\.ts$|(^|/)vite\\.config\\.ts$|^(apps|packages|tools)/[^/]+/dist/)"
    },
    "parser": "swc",
    "tsPreCompilationDeps": true,
    "enhancedResolveOptions": {
      "exportsFields": ["exports"],
      "conditionNames": ["import", "default"],
      "extensions": [".ts", ".tsx", ".js"]
    }
  }
}
