{
  "forbidden": [
    {
      "name": "no-unresolvable-import",
      "severity": "error",
      "from": {},
      "to": { "couldNotResolve": true }
    },
    {
      "name": "nothing-imports-tools",
      "severity": "error",
      "from": { "pathNot": "^tools/" },
      "to": { "path": "^tools/" }
    },
    {
      "name": "math-depends-on-nothing",
      "severity": "error",
      "from": { "path": "^packages/math/" },
      "to": { "pathNot": "^packages/math/" }
    },
    {
      "name": "schema-depends-on-math",
      "severity": "error",
      "from": { "path": "^packages/schema/" },
      "to": { "pathNot": "^packages/(math|schema)/" }
    },
    {
      "name": "domain-depends-on-math-and-schema",
      "severity": "error",
      "from": { "path": "^packages/domain/" },
      "to": { "pathNot": "^packages/(math|schema|domain)/" }
    },
    {
      "name": "sim-depends-on-math-schema-domain",
      "severity": "error",
      "from": { "path": "^packages/sim/" },
      "to": { "pathNot": "^packages/(math|schema|domain|sim)/" }
    },
    {
      "name": "catalog-depends-on-math-schema-inversify",
      "severity": "error",
      "from": { "path": "^packages/catalog/" },
      "to": {
        "pathNot": ["^packages/(math|schema|catalog)/", "(^|/)node_modules/inversify/"]
      }
    },
    {
      "name": "render-never-imports-domain",
      "severity": "error",
      "from": { "path": "^packages/render/" },
      "to": {
        "pathNot": [
          "^packages/(math|schema|catalog|render)/",
          "(^|/)node_modules/(inversify|three)/"
        ]
      }
    },
    {
      "name": "storage-and-rpc-depend-on-schema-inversify",
      "severity": "error",
      "from": { "path": "^packages/(storage|rpc)/" },
      "to": {
        "pathNot": ["^packages/(schema|storage|rpc)/", "(^|/)node_modules/inversify/"]
      }
    },
    {
      "name": "import-depends-on-its-engines",
      "severity": "error",
      "from": { "path": "^packages/import/" },
      "to": { "pathNot": "^packages/(math|schema|domain|catalog|compile-wasm|import)/" }
    },
    {
      "name": "client-depends-on-l2-adapters",
      "severity": "error",
      "from": { "path": "^packages/client/" },
      "to": {
        "pathNot": [
          "^packages/(domain|catalog|render|storage|rpc|client)/",
          "(^|/)node_modules/inversify/"
        ]
      }
    },
    {
      "name": "client-takes-only-types-from-sim-and-import",
      "severity": "error",
      "from": { "path": "^packages/client/" },
      "to": { "path": "^packages/(sim|import)/", "dependencyTypesNot": ["type-only"] }
    },
    {
      "name": "workers-depend-on-rpc-and-their-engine",
      "severity": "error",
      "from": { "path": "^packages/workers/" },
      "to": {
        "pathNot": [
          "^packages/(rpc|sim|import|render|math|schema|domain|catalog|compile-wasm|workers)/",
          "(^|/)node_modules/inversify/"
        ]
      }
    },
    {
      "name": "ui-goes-through-client",
      "severity": "error",
      "from": { "path": "^packages/ui/" },
      "to": { "path": "^packages/(domain|render|storage|catalog|rpc|math|sim|import)/" }
    },
    {
      "name": "ui-takes-only-types-from-schema",
      "severity": "error",
      "from": { "path": "^packages/ui/" },
      "to": { "path": "^packages/schema/", "dependencyTypesNot": ["type-only"] }
    },
    {
      "name": "web-composes-ui-client-workers",
      "severity": "error",
      "from": { "path": "^apps/web/" },
      "to": {
        "pathNot": [
          "^apps/web/",
          "^packages/(ui|client|workers)/",
          "(^|/)node_modules/(inversify|react|react-dom)/"
        ]
      }
    },
    {
      "name": "asset-pipeline-depends-on-pure-packages-and-catalog",
      "severity": "error",
      "from": { "path": "^tools/asset-pipeline/" },
      "to": { "path": "^packages/", "pathNot": "^packages/(math|schema|domain|catalog)/" }
    }
  ],
  "options": {
    "doNotFollow": { "path": "(^|/)node_modules/" },
    "exclude": {
      "path": "(\\.test\\.ts$|(^|/)vitest\\.config\\.ts$|(^|/)vite\\.config\\.ts$|(^|/)dist/)"
    },
    "parser": "swc",
    "tsPreCompilationDeps": true,
    "enhancedResolveOptions": {
      "exportsFields": ["exports"],
      "conditionNames": ["import", "default"],
      "extensions": [".ts", ".tsx", ".js"]
    }
  }
}
