{
  "name": "@brr/asset-pipeline",
  "private": true,
  "type": "module",
  "scripts": {
    "fetch-ldraw": "node --experimental-transform-types --no-warnings src/cli.ts fetch",
    "restore-ldraw": "node --experimental-transform-types --no-warnings src/cli.ts restore",
    "attribution": "node --experimental-transform-types --no-warnings src/cli.ts attribution",
    "verify-ldraw": "node --experimental-transform-types --no-warnings src/cli.ts verify",
    "section-vocabulary": "node --experimental-transform-types --no-warnings src/cli.ts section-vocabulary",
    "library-connectors": "node src/library-connectors/cli.ts",
    "shadow-library": "node src/shadow-library/cli.ts",
    "build": "node --experimental-transform-types --no-warnings src/cli.ts bundle",
    "typecheck": "tsc -p tsconfig.json",
    "facts": "node --experimental-transform-types --no-warnings src/cli.ts facts",
    "colors": "node --experimental-transform-types --no-warnings src/cli.ts colors",
    "ldraw-library": "node src/library/cli.ts",
    "library-bake": "node src/library-bake/cli.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@brr/catalog": "workspace:*",
    "@brr/domain": "workspace:*",
    "@brr/math": "workspace:*",
    "@brr/schema": "workspace:*",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@brr/config": "workspace:*",
    "@types/node": "22.20.5",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
